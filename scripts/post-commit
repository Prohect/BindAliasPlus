#!/bin/bash
# =============================================================================
# post-commit hook: sync configured files across active branches.
#
# What it does:
#   On every commit, this hook reads .git_active_branches (target branches)
#   and .git_sync_across_active_branches (glob patterns of files to sync).
#   For files changed in this commit that match the patterns, it injects
#   their new content into each target branch's tree and creates a new
#   commit there with the same commit message (+ source SHA footer).
#
# What it does NOT do:
#   - Does NOT copy the entire commit (no cherry-pick / merge).
#   - Does NOT sync files not listed in .git_sync_across_active_branches.
#     Source code, build scripts, etc. must be manually merged per branch.
#   - Does NOT resolve conflicts — if the file doesn't exist on the target
#     branch, the sync is skipped silently (via update-index || true).
#
# Target branches that == the source branch are skipped.
# Branches with no matching changed files are skipped.
#
# To install:  ln scripts/sync-post-commit .git/hooks/post-commit
# =============================================================================
set -u

BRANCHES_FILE=".git_active_branches"
PATTERNS_FILE=".git_sync_across_active_branches"

# --- gracefully handle missing config (single-branch clone, new dev) ---
[ -f "$BRANCHES_FILE" ] || exit 0
[ -f "$PATTERNS_FILE" ] || exit 0

# --- helpers ---
read_lines() {
  local file="$1"; local -n arr="$2"; arr=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    arr+=("$line")
  done < "$file"
}

match_pattern() {
  for p in "${patterns[@]}"; do
    [[ "$1" == $p ]] && return 0
  done
  return 1
}

expand_globs() {
  for p in "$@"; do
    if [[ "$p" == *\** || "$p" == *\?* ]]; then
      git ls-files "$p" 2>/dev/null
    else
      echo "$p"
    fi
  done
}

# --- load config ---
read_lines "$BRANCHES_FILE" branches
read_lines "$PATTERNS_FILE" patterns

[ ${#branches[@]} -gt 0 ] || exit 0
[ ${#patterns[@]} -gt 0 ] || exit 0

# --- detect synced files from this commit ---
changed=$(git diff-tree --no-commit-id --name-only -r HEAD)
synced=()
for f in $changed; do
  match_pattern "$f" && synced+=("$f")
done

[ ${#synced[@]} -eq 0 ] && exit 0

# --- expand globs (MUST run before touching GIT_INDEX_FILE) ---
expanded=()
while IFS= read -r f; do expanded+=("$f"); done < <(expand_globs "${synced[@]}")

SOURCE=$(git rev-parse --abbrev-ref HEAD)
SOURCE_SHA=$(git rev-parse --short HEAD)

# --- mirror source commit message ---
MSG=$(git log -1 --format='%B' HEAD)
MSG="${MSG}

source: ${SOURCE_SHA}"

# --- sync to each target ---
for target in "${branches[@]}"; do
  [ "$target" = "$SOURCE" ] && continue

  tmpidx=$(mktemp -u /tmp/git-sync-idx-XXXXXX)
  export GIT_INDEX_FILE="$tmpidx"
  git read-tree "$target" 2>/dev/null

  git ls-tree HEAD --format='%(objectmode) %(objectname) 0%x09%(path)' -- "${expanded[@]}" \
    | git update-index --index-info 2>/dev/null || true

  # Remove synced files that were deleted in the source commit
  for f in "${expanded[@]}"; do
    git cat-file -e "HEAD:$f" 2>/dev/null && continue
    git rm --cached --quiet -- "$f" 2>/dev/null || true
  done

  new_tree=$(git write-tree)
  old_tree=$(git rev-parse "$target^{tree}")
  unset GIT_INDEX_FILE; rm -f "$tmpidx"

  if [ "$new_tree" != "$old_tree" ]; then
    new_commit=$(git commit-tree "$new_tree" -p "$target" -m "$MSG")
    git update-ref "refs/heads/$target" "$new_commit"
    echo "  synced → $target"
  fi
done

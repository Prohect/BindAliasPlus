#!/bin/bash
# =============================================================================
# post-checkout hook:  keep LSP/IDE in sync with the current branch
#
# Caches Eclipse project files (.classpath, .project) per branch under
# minecraft-decompiled-sources/.cache/$BRANCH/ so that switching back to a
# previously-built branch skips the Gradle toolchain entirely.
#
# Cache validity is tied to a hash of build-config files (build.gradle,
# gradle.properties, settings.gradle).  When those change the cache is
# automatically invalidated and the full pipeline reruns.
#
# To install:  cp scripts/post-checkout .git/hooks/post-checkout
# =============================================================================

PREV_HEAD=$1
NEW_HEAD=$2
# checkout type:  1 = branch switch,  0 = file checkout
CHECKOUT_TYPE=$3

if [ "$CHECKOUT_TYPE" != "1" ]; then
    exit 0
fi

echo ""
echo "=== Branch switch detected → syncing JDTLS ==="
echo "    from: $PREV_HEAD"
echo "    to:   $NEW_HEAD"

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
BRANCH="$(git branch --show-current)"
echo "=== Branch: $BRANCH ==="

SRC_DIR="minecraft-decompiled-sources/$BRANCH"
CACHE_DIR="minecraft-decompiled-sources/.cache/$BRANCH"
CACHED_CLASSPATH="$CACHE_DIR/.classpath"
CACHED_PROJECT="$CACHE_DIR/.project"
CACHED_BUILDHASH="$CACHE_DIR/.buildhash"

# Files whose contents determine whether the cached classpath is still valid
BUILD_FILES="build.gradle gradle.properties settings.gradle"

# ------------------------------------------------------------------
# Compute a hash of the build-config files that affect the classpath
# ------------------------------------------------------------------
compute_buildhash() {
    cat $BUILD_FILES 2>/dev/null | md5sum | cut -d' ' -f1
}

# ------------------------------------------------------------------
# Determine whether a valid cache exists:
#   - cached .classpath + .project are present
#   - cached buildhash matches current build files
#   - decompiled MC sources are already extracted
# ------------------------------------------------------------------
CACHE_VALID=false
if [ -f "$CACHED_CLASSPATH" ] && [ -f "$CACHED_PROJECT" ] && \
   [ -f "$CACHED_BUILDHASH" ] && \
   [ -d "$SRC_DIR" ] && [ "$(find "$SRC_DIR" -name '*.java' 2>/dev/null | wc -l)" -gt 0 ]; then

    CURRENT_HASH=$(compute_buildhash)
    CACHED_HASH=$(cat "$CACHED_BUILDHASH")

    if [ "$CURRENT_HASH" = "$CACHED_HASH" ]; then
        CACHE_VALID=true
    else
        echo "[cache stale] Build config changed — invalidating cache"
        echo "  cached:  $CACHED_HASH"
        echo "  current: $CURRENT_HASH"
    fi
fi

# ==================================================================
# CACHE HIT — restore files, skip the Gradle toolchain entirely
# ==================================================================
if $CACHE_VALID; then
    echo "[cache hit] Restoring Eclipse config + sources for '$BRANCH'..."
    cp "$CACHED_CLASSPATH" .classpath
    cp "$CACHED_PROJECT"  .project
    rm -f ./BindAliasPlus_*.launch
    echo "  $(find "$SRC_DIR" -name '*.java' | wc -l) source files ready"
    echo ""
    echo "Done."
    set +e
    exit 0
fi

# ==================================================================
# CACHE MISS — run the full pipeline, then populate the cache
# ==================================================================

# Step 1: Generate decompiled Minecraft sources (if not already present)
if [ -d "$SRC_DIR" ] && [ "$(find "$SRC_DIR" -name '*.java' 2>/dev/null | wc -l)" -gt 0 ]; then
    echo "[1/4] Sources already present: $SRC_DIR ($(find "$SRC_DIR" -name '*.java' | wc -l) files)"
else
    echo "[1/4] Generating Minecraft sources..."
    ./gradlew clean
    ./gradlew genSources --no-daemon --quiet
fi

# Step 2: Generate Eclipse .classpath + .project
echo "[2/4] Generating Eclipse config..."
./gradlew eclipse --no-daemon --quiet

# Step 3: Strip Buildship references (they're not needed for JDTLS / plain Eclipse)
echo "[3/4] Stripping Buildship references..."
sed -i '/gradleclasspathcontainer/d' .classpath
sed -i '/gradleprojectnature/d'     .project
sed -i '/<buildCommand>/{:a;N;/<\/buildCommand>/!ba;/gradleprojectbuilder/d}' .project

# Clean up .launch files (Eclipse run-config boilerplate — not needed for JDTLS)
rm -f ./BindAliasPlus_*.launch

# Step 4: Extract MC source jars → minecraft-decompiled-sources/ for agent browsing
if [ -d "$SRC_DIR" ] && [ "$(find "$SRC_DIR" -name '*.java' | wc -l)" -gt 0 ]; then
    echo "[4/4] Sources already extracted: $SRC_DIR ($(find "$SRC_DIR" -name '*.java' | wc -l) files)"
else
    echo "[4/4] Extracting Minecraft sources → $SRC_DIR ..."
    rm -rf "$SRC_DIR"
    mkdir -p "$SRC_DIR"
    grep -o 'sourcepath="[^"]*loom-cache[^"]*-sources\.jar"' .classpath | sed 's/sourcepath="//;s/"$//' | sort -u | while read srcjar; do
        echo "  extracting: $srcjar"
        unzip -o -q "$srcjar" -d "$SRC_DIR"/
    done
    FILE_COUNT=$(find "$SRC_DIR" -name '*.java' | wc -l)
    echo "  done: $FILE_COUNT files"
    if [ "$FILE_COUNT" -eq 0 ]; then
        echo "ERROR: No Java sources extracted. Check that genSources succeeded." >&2
        exit 1
    fi
fi

# Populate the cache so the next checkout of this branch skips Gradle
echo "[cache] Saving Eclipse config for branch '$BRANCH'..."
mkdir -p "$CACHE_DIR"
cp .classpath "$CACHED_CLASSPATH"
cp .project  "$CACHED_PROJECT"
compute_buildhash > "$CACHED_BUILDHASH"

echo ""
echo "Done."

set +e

{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.settings",
    // custom, focus on daily develop, comment out line if need
    "[^/]*.launch",
    ".classpath**",
    ".gitattributes**",
    ".project**",
    "BUILD.md**",
    "CONTRIBUTE.md**",
    "LICENSE**",
    "settings.gradle**",
    ".github/**",
    ".gradle/**",
    "bin/**",
    "build/**",
    "docs/**",
    "gradle/**",
    "release/**",
  ],
  "enable_language_server": true,
  "read_only_files": [],
}
